# Copy to .env and fill in. .env is gitignored and never enters the Docker image.

# ---- LLM ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- MCP servers ----
# Remote (HTTP)
TAVILY_API_KEY=
# Local (stdio)
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# ---- LangGraph checkpointer ----
# Render external URL, or the local-db compose profile:
#   postgresql://tripmind:tripmind@postgres:5432/tripmind?sslmode=disable
DATABASE_URL=

# ---- Redis cache (optional) ----
# Leave REDIS_URL unset to run without a cache - the app works fine, it just
# repeats the MCP calls. docker compose overrides this to redis://redis:6379/0.
# On Render, use the Key Value service's Internal URL.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
# CACHE_RECONNECT_SECONDS=60

# Optional TTL overrides, in seconds
# CACHE_TTL_AIRPORTS=604800
# CACHE_TTL_AIRLINES=604800
# CACHE_TTL_HOTELS=21600
# CACHE_TTL_FORECAST=3600
# CACHE_TTL_WEATHER=600
# CACHE_TTL_DESTINATION=86400

# ---- Server ----
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Host-side ports for docker compose. Change these if another project on
# this machine already owns the default. Container-internal ports do not
# change, so nothing else needs updating.
APP_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432

# ---- Observability (optional) ----
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

